{
    "version": 1,
    "fileType": "SettingsUI",
    "imports": [
        "QGC as App"
    ],
    "groups": [
        {
            "heading": "SIYI Camera Control",
            "keywords": [
                "siyi",
                "zt30",
                "zt6",
                "zr30",
                "a8",
                "gimbal",
                "optical pod",
                "payload",
                "ai",
                "tracking"
            ],
            "showWhen": "QGroundControl.settingsManager.siyiCameraSettings.userVisible",
            "controls": [
                {
                    "setting": "siyiCameraSettings.enabled"
                },
                {
                    "setting": "siyiCameraSettings.ipAddress",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.port",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.secondaryRtspUrl",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.fpvRtspUrl"
                },
                {
                    "setting": "siyiCameraSettings.autoRecordMission",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.aiEnabled"
                },
                {
                    "setting": "siyiCameraSettings.aiIpAddress",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.aiEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.aiPort",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.aiEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.aiRtspUrl",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.aiEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.sendFcDataToGimbal",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.fcDataLayout",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.sendFcDataToGimbal.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.crowdModerateCount",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.aiEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.crowdDenseCount",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.aiEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyFpvChannel",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyZoomChannel",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyWideChannel",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyThermalChannel",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyCenterChannel",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyTalkChannel"
                },
                {
                    "setting": "siyiCameraSettings.rcKeyCameraChannel",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                }
            ]
        },
        {
            "heading": "Thermal Measurement",
            "keywords": [
                "thermal",
                "temperature",
                "emissivity",
                "humidity",
                "calibration",
                "열화상",
                "온도",
                "방사율"
            ],
            "showWhen": "QGroundControl.settingsManager.siyiCameraSettings.userVisible",
            "controls": [
                {
                    "setting": "siyiCameraSettings.thermalCorrectionEnabled",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.enabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.thermalEmissivity",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.thermalCorrectionEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.thermalHumidity",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.thermalCorrectionEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.thermalAmbientTempC",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.thermalCorrectionEnabled.rawValue"
                },
                {
                    "setting": "siyiCameraSettings.thermalReflectedTempC",
                    "enableWhen": "QGroundControl.settingsManager.siyiCameraSettings.thermalCorrectionEnabled.rawValue"
                },
                {
                    "comment": "The path length is the one constant nobody types: the rangefinder measures it.",
                    "control": "info",
                    "label": "측정 거리",
                    "value": "App.SiyiCameraController.thermalCalibrationDistanceM > 0 ? qsTr(\"%1 m (거리계)\").arg(App.SiyiCameraController.thermalCalibrationDistanceM.toFixed(0)) : qsTr(\"거리계 대기 중\")"
                }
            ]
        },
        {
            "heading": "Loudspeaker Payload",
            "keywords": [
                "speaker",
                "loudspeaker",
                "broadcast",
                "warning",
                "announcement",
                "경고방송"
            ],
            "controls": [
                {
                    "setting": "speakerSettings.enabled"
                },
                {
                    "setting": "speakerSettings.ipAddress",
                    "enableWhen": "QGroundControl.settingsManager.speakerSettings.enabled.rawValue"
                },
                {
                    "setting": "speakerSettings.port",
                    "enableWhen": "QGroundControl.settingsManager.speakerSettings.enabled.rawValue"
                },
                {
                    "setting": "speakerSettings.messageNames",
                    "enableWhen": "QGroundControl.settingsManager.speakerSettings.enabled.rawValue"
                }
            ]
        }
    ]
}
