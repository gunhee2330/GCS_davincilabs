<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a quadcopter seen from above, carrying a gimbal ball.
     Drawn inside the 66/108dp safe zone (the group scales the 72dp artboard to 0.72
     about its centre) so launcher masks never clip an arm. The gimbal is the only
     accent colour, which is what tells this apart from a generic drone icon at 48dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="10.08"
        android:translateY="10.08">

        <!-- Arms, drawn as one X so the strokes meet cleanly under the body. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M20,20 L52,52 M52,20 L20,52"/>

        <!-- Rotor rings. Open circles read better than discs once the icon is 48dp. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M20,20m-11,0a11,11 0 1,0 22,0a11,11 0 1,0 -22,0"/>
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M52,20m-11,0a11,11 0 1,0 22,0a11,11 0 1,0 -22,0"/>
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M20,52m-11,0a11,11 0 1,0 22,0a11,11 0 1,0 -22,0"/>
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M52,52m-11,0a11,11 0 1,0 22,0a11,11 0 1,0 -22,0"/>

        <!-- Body. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M27,27h18a4,4 0 0,1 4,4v10a4,4 0 0,1 -4,4h-18a4,4 0 0,1 -4,-4v-10a4,4 0 0,1 4,-4z"/>

        <!-- Gimbal ball with its lens, slung under the body. -->
        <path
            android:fillColor="#33C7FF"
            android:pathData="M36,45m-9,0a9,9 0 1,0 18,0a9,9 0 1,0 -18,0"/>
        <path
            android:fillColor="#0B2233"
            android:pathData="M36,45m-4,0a4,4 0 1,0 8,0a4,4 0 1,0 -8,0"/>
    </group>
</vector>
