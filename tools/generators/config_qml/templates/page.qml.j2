{{ header }}

{% for imp in imports %}
import {{ imp }}
{% endfor %}
{% if imports %}

{% endif %}
SetupPage {
    id: configPage
    pageComponent: pageComponent

    Component {
        id: pageComponent

        Item {
            // The floor is a constant rather than outerColumn.width because outerColumn now
            // takes its width from this Item, and reading it back would close a binding loop
            width: Math.max(availableWidth, ScreenTools.defaultFontPixelWidth * 70)
            height: outerColumn.height

            {{ controller_type }} {
                id: controller
            }

            property real _margins: ScreenTools.defaultFontPixelHeight

{% for name, expr in constants %}
            readonly property var {{ name }}: {{ expr }}
{% endfor %}
{% if constants %}

{% endif %}
{% for line in param_lines %}
            {{ line }}
{% endfor %}
{% if param_lines %}

{% endif %}
{% for name, expr in bindings %}
            property var {{ name }}: {{ expr }}
{% endfor %}
{% if bindings %}

{% endif %}
{% for rc in repeat_count_props %}
{{ rc }}

{% endfor %}
            property string sectionIdFilter: ""

            // Keyed by untranslated section ID (must match VehicleComponent::sectionIds())
            readonly property var _searchTerms: ({
{% for st in search_terms %}
                "{{ st.section_id }}": [{{ st.terms }}]{{ st.comma }}
{% endfor %}
            })

            readonly property var _translatableSearchTerms: ({
{% for tt in tr_terms %}
                "{{ tt.section_id }}": [{{ tt.terms }}]{{ tt.comma }}
{% endfor %}
            })

            // sectionId must be untranslated; repeat sections pass their base ID as searchKey
            function sectionMatchesFilter(sectionId, searchKey) {
                if (sectionIdFilter === "") {
                    return true
                }
                if (sectionIdFilter === sectionId) {
                    return true
                }
                if (searchKey === undefined) {
                    searchKey = sectionId
                }
                let filter = sectionIdFilter.toLowerCase()
                let terms = _searchTerms[searchKey]
                if (terms) {
                    for (let i = 0; i < terms.length; i++) {
                        if (terms[i].indexOf(filter) >= 0) {
                            return true
                        }
                    }
                }
                let trTerms = _translatableSearchTerms[searchKey]
                if (trTerms) {
                    for (let j = 0; j < trTerms.length; j++) {
                        if (qsTranslate("{{ tr_ctx }}", trTerms[j]).toLowerCase().indexOf(filter) >= 0) {
                            return true
                        }
                    }
                }
                return false
            }

            function sectionVisible(sectionId) {
                switch (sectionId) {
{% for vc in visible_conditions %}
                case "{{ vc.name }}":
                    return {{ vc.expr }}
{% endfor %}
                default:
                    return true
                }
            }

            ColumnLayout {
                id: outerColumn
                spacing: _margins * 1.25
                // Cards span the panel rather than huddling in its middle. Stock centred the
                // content for a full window; the config rail already narrows the body, so
                // centring only left the cards adrift of the left-aligned panel title above.
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.leftMargin: _margins
                anchors.rightMargin: _margins
{% for sec_qml in sections %}

{{ sec_qml }}
{% endfor %}
            }
        }
    }
}
